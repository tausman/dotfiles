# Tausif Ghostty config — mirrors ~/.config/alacritty/alacritty.toml

# Report as xterm-256color for remote compatibility (matches Alacritty's [env] TERM).
# Without this Ghostty advertises xterm-ghostty, whose terminfo is often absent on
# remote hosts.
term = xterm-256color

# --- Window ---
# Borderless / no title bar, matching Alacritty's decorations = "None".
window-decoration = false
# Start full screen, closest match to Alacritty's startup_mode = "Maximized".
fullscreen = true
# `padded-notch` = non-native fullscreen (overlays the CURRENT Space, so Ctrl+Cmd+F never
# banishes the window to its own workspace) but inset so the notch can't cover the top row.
# Plain `true` is the same thing without the inset, which is what hid the first line.
# Trade-off: non-native fullscreen disables Ghostty's own tabs (irrelevant here -- tmux
# handles that), and the area beside the notch stays transparent rather than filled.
macos-non-native-fullscreen = padded-notch
# Don't let macOS window-state restoration reopen the previous window geometry on top of
# `maximize` — start fresh every launch.
window-save-state = never
# Treat both Option keys as Alt (matches Alacritty's option_as_alt = "Both").
macos-option-as-alt = true

# --- Font ---  (Hack Nerd Font Mono is supplied by modules/alacritty.nix)
font-family = Hack Nerd Font Mono
font-size = 11.75

# --- Cursor ---
# Blinking block (Alacritty: cursor.style.blinking = "Always").
# NOTE: unlike Alacritty's "Always", cursor-style-blink is only the DEFAULT -- Ghostty always
# honours DECSCUSR (`CSI <n> q`) from the running program. Since zsh's vi-mode plugin and
# nvim's guicursor both request *steady* shapes by default, the blink has to be enabled on
# their side too: see VI_MODE_CURSOR_* in zshrc/.zshrc and guicursor in nvim's set.lua.
cursor-style = block
cursor-style-blink = true

# --- Theme ---
# Swap the include below to change themes (mirrors Alacritty's [general].import list).
config-file = themes/tausif_light_theme_soft
