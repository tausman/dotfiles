# Tausif Personal Dark theme
# Ported from Alacritty themes/github_dark_high_contrast_alacritty_background.toml:
# the GitHub Dark High Contrast palette on the #121212 background (which is also what
# the desktop wallpaper in nix-config/darwin.nix matches). Pairs with nvim's
# github_dark_high_contrast. Note black / bright black are deliberately the same as the
# background, as in the Alacritty original.

# Primary
background = #121212
foreground = #f0f3f6

# Cursor (only used outside tmux -- inside a pane tmux owns the cursor colour)
cursor-color = #f0f3f6
cursor-text = #0a0c10

# Normal colors (ANSI 0-7)
palette = 0=#121212
palette = 1=#ff9492
palette = 2=#26cd4d
palette = 3=#f0b72f
palette = 4=#71b7ff
palette = 5=#cb9eff
palette = 6=#39c5cf
palette = 7=#d9dee3

# Bright colors (ANSI 8-15)
palette = 8=#121212
palette = 9=#ffb1af
palette = 10=#4ae168
palette = 11=#f7c843
palette = 12=#91cbff
palette = 13=#cb9eff
palette = 14=#39c5cf
palette = 15=#d9dee3
