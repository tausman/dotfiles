# Bringing your own custom configuration
# Auth bootstrap applied to workspaces ONLY when WS_TMUX is set in the
# environment (e.g. `WS_TMUX=1 ssh workspace-foo`). The `exec` Match criteria
# runs the test locally and only applies the block when it exits 0:
#   - tmux is resolved as the nix-managed one (~/.nix-profile/bin/tmux) first, falling back
#     to whatever's on PATH. This runs in a bare non-login bash where ~/.nix-profile/bin
#     isn't on PATH, so `command -v tmux` alone would pick the old /usr/bin/tmux.
#   - TMUX_TMPDIR is forced to /tmp when the inherited one (e.g. /run/user/$UID on a
#     workspace container without logind) isn't writable — otherwise tmux can't create its
#     socket. This bare bash doesn't run the interactive .zshrc guard, so it's done here too.
#   - If tmux isn't available on the remote, just run `ddtool auth login`.
#   - If tmux is available, refresh an "auth" window running the login command
#     and attach to the most recently used session (creating "scratch" only if
#     no session exists yet) instead of always landing in "scratch".
# Without WS_TMUX, connections get a plain shell and no forced RemoteCommand,
# so tools that run their own remote command (e.g. `git config-tool export`)
# aren't hijacked.
Match host "local-*,workspace-*,*.workspace.infra.dog" exec "test -n \"$WS_TMUX\""
    RequestTTY force
    RemoteCommand /bin/bash -c 'T="$HOME/.nix-profile/bin/tmux"; [ -x "$T" ] || T=$(command -v tmux); if [ ! -x "$T" ]; then ddtool auth login --datacenter us1.ddbuild.io; exec "$SHELL"; fi; [ -n "${TMUX_TMPDIR:-}" ] && [ ! -w "$TMUX_TMPDIR" ] && export TMUX_TMPDIR=/tmp; $T list-sessions >/dev/null 2>&1 || $T new-session -ds scratch; S=$($T list-sessions -F "#{session_activity} #{session_name}" 2>/dev/null | sort -rn | head -n1 | cut -d" " -f2-); [ -z "$S" ] && S=scratch; $T kill-window -t "$S:auth" 2>/dev/null; $T new-window -t "$S" -n auth "ddtool auth login --datacenter us1.ddbuild.io; exec \$SHELL"; exec $T attach -t "$S"'
