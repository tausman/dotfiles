{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "exposure": "deferred",
      "description": "Search and work with Jira issues and Confluence pages."
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackUrl": "http://localhost:3118/callback"
      },
      "exposure": "deferred",
      "description": "Search Slack messages and channels."
    },
    "datadog-mcp": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
      "exposure": "deferred",
      "description": "Query Datadog production observability data."
    },
    "datadog-staging-mcp": {
      "type": "http",
      "url": "https://mcp.datad0g.com/api/unstable/mcp-server/mcp",
      "exposure": "deferred",
      "description": "Query Datadog staging observability data."
    },
    "datadog-google-workspace": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://google-workspace-mcp-server-834963730936.us-central1.run.app/mcp"
      ],
      "env": {}
    },
    "orgstore-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5435/aaa_authn"
      ],
      "env": {},
      "exposure": "deferred",
      "description": "Run read-only SQL against the local orgstore Postgres connection on port 5435."
    },
    "trajectory": {
      "type": "stdio",
      "command": "node",
      "args": [
        "~/dotfiles/pi/trajectory-mcp.cjs"
      ],
      "exposure": "deferred",
      "description": "Inspect local Trajectory capture status and recorded sessions."
    }
  }
}
