      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "datadog-google-workspace": {
      "url": "https://google-workspace-mcp-server-834963730936.us-central1.run.app/mcp"
    },
    "datadog-mcp": {
      "description": "Query Datadog production observability data.",
      "exposure": "deferred",
      "type": "http",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp"
    },
    "datadog-staging-mcp": {
      "description": "Query Datadog staging observability data.",
      "exposure": "deferred",
      "type": "http",
