      "type": "stdio"
    },
    "slack": {
      "description": "Search Slack messages and channels.",
      "exposure": "deferred",
      "oauth": {
        "callbackUrl": "http://localhost:3118/callback",
        "clientId": "1601185624273.8899143856786"
      },
      "type": "http",
      "url": "https://mcp.slack.com/mcp"
    }
