<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manual-install LaunchDaemon for kmonad (reference / non-nix machines).

  On a nix-darwin machine you do NOT load this file — nix-darwin manages the daemon
  declaratively via `launchd.daemons.kmonad` in nix-config/darwin.nix and generates
  its own /Library/LaunchDaemons/org.nixos.kmonad.plist. Loading both would run
  kmonad twice.

  For a machine without nix-darwin: install kmonad, copy this to
  /Library/LaunchDaemons/com.example.kmonad.plist, adjust the binary path below to
  wherever kmonad lives, then `sudo launchctl bootstrap system <path>`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.kmonad</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/tausif.rahman/.local/bin/kmonad</string>
        <string>/Users/tausif.rahman/.config/kmonad.kbd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>Nice</key>
    <integer>-20</integer>

    <key>StandardOutPath</key>
    <string>/tmp/kmonad.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/kmonad.err.log</string>
</dict>
</plist>
